# --- Supabase (database + auth) ---
# Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Cloudinary (file storage — images, PDFs, ZIPs, videos) ---
# cloudinary.com/console for the cloud name; create an unsigned upload
# preset under Settings -> Upload -> Upload presets. See README.md
# "File storage: Cloudinary" for exact steps.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# .env is gitignored — never commit real keys. None of the above are
# traditional secrets (they're visible in any deployed web app's bundle);
# what actually protects your data is supabase/schema.sql's Row Level
# Security policies, the `admins` table allow-list, and the scoping you
# set on the Cloudinary upload preset. The real secrets — Cloudinary's API
# secret and Supabase's service role key — never go in this file; they're
# set as Supabase Edge Function secrets instead (see README).
