{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "iotlab-testing",
  "compatibility_date": "2026-08-16",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "iot.omrawat.com",
      "custom_domain": true
    }
  ]
}